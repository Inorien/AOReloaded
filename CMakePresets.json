{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 24,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "linux-release",
            "displayName": "Release (x86, Linux / WSL cross via xwin)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/linux-release",
            "toolchainFile": "${sourceDir}/cmake/xwin-linux.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "windows-release",
            "displayName": "Release (x86, clang-cl on Windows)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/windows-release",
            "toolchainFile": "${sourceDir}/cmake/windows-clangcl.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang-cl",
                "CMAKE_CXX_COMPILER": "clang-cl",
                "CMAKE_LINKER": "lld-link",
                "CMAKE_C_COMPILER_TARGET": "i686-pc-windows-msvc",
                "CMAKE_CXX_COMPILER_TARGET": "i686-pc-windows-msvc"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug (x86)",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release",
            "displayName": "Release (x86)",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "dev",
            "displayName": "Dev (RelWithDebInfo, x86)",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build/dev",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "linux-release",
            "configurePreset": "linux-release"
        },
        {
            "name": "windows-release",
            "configurePreset": "windows-release"
        },
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "release",
            "configurePreset": "release"
        },
        {
            "name": "dev",
            "configurePreset": "dev"
        }
    ]
}
